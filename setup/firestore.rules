rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check the group document exists and caller knows the right group ID
    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      // Any caller who knows the groupId may read
      allow read: if groupExists(groupId);

      // No client-side writes to the group document (managed by backend only)
      allow write: if false;

      // ── Tasks subcollection ────────────────────────────────────────────────
      match /tasks/{taskId} {
        // Read allowed for anyone who knows the groupId
        allow read: if groupExists(groupId);

        // Writes disallowed from client; all mutations go through the backend
        allow write: if false;
      }
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
